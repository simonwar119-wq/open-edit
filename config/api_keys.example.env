# open-edit API 密钥模板（脱敏）。复制成 secrets.env 并填真实值。
# 说明见 config/README.md。

# ── 🟢 核心（现在就用）──────────────────────────
FAL_API_KEY=            # fal.ai：生成核心（Seedance/Kling/NBP/FLUX-LoRA/face-swap）
DEEPSEEK_API_KEY=       # DeepSeek：导演大脑 LLM
GEMINI_API_KEY=         # Google Gemini：Gemini CLI 研究/讨论

# ── 🟡 官方 Seedance 2.0（计划接入）─────────────
ARK_API_KEY=            # 火山方舟：官方 Seedance 2.0（Bearer token，待申请）
VOLCENGINE_ACCESS_KEY=  # 火山引擎 AK
VOLCENGINE_SECRET_KEY=  # 火山引擎 SK

# ── 🔵 可能用到（备选/未来）─────────────────────
OPENROUTER_API_KEY=     # OpenRouter：LLM 路由（导演大脑备选；⚠️无视频生成）
ANTHROPIC_API_KEY=      # Anthropic Claude（可选导演/agent）
DASHSCOPE_API_KEY=      # 阿里灵积：Wan 2.2 视频官方 API
DEEPGRAM_API_KEY=       # Deepgram ASR（字幕备选）
DOUBAO_API_KEY=         # 豆包/火山 LLM/Vision
OSS_ACCESS_KEY=         # 阿里云 OSS 存储
SHOTSTACK_API_KEY=      # Shotstack 云渲染（备选）
REMOTION_AWS_ACCESS_KEY=        # AWS Remotion Lambda（大概率不用）
REMOTION_AWS_SECRET_ACCESS_KEY=
